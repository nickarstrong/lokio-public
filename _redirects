# LOKIO. Cloudflare Pages routing.
# Cloudflare Pages "Pretty URLs" handles .html stripping automatically.
# Do NOT add /documents/X -> /documents/X.html rewrites — causes redirect loops.

# ── Documents index (no hub page, redirect to whitepaper) ──
/documents    /documents/whitepaper    302
/documents/   /documents/whitepaper    302

